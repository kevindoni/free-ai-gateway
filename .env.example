# Free AI Token Gateway Environment Configuration
# Copy this file to .env and fill in your API keys

# --- Gateway Settings ---
GATEWAY_PORT=8080
GATEWAY_HOST=127.0.0.1
GATEWAY_API_KEY=***

# --- Database ---
DATABASE_PATH=./data/gateway.db

# --- Provider API Keys (Free Tiers) ---
# Google Gemini (Free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (Free: https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter (Free: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Cloudflare Workers AI (Free: https://developers.cloudflare.com/workers/)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# NVIDIA NIM (Free: https://build.nvidia.com/)
NVIDIA_API_KEY=

# DeepSeek (Paid: https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Z.ai / Zhipu GLM (Free: https://z.ai/api)
ZAI_API_KEY=

# Mistral (Free: https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# GitHub Models (Free: https://github.com/settings/tokens)
GITHUB_TOKEN=

# HuggingFace (Free: https://huggingface.co/settings/tokens)
HF_TOKEN=

# Cohere (Free Trial: https://cohere.com/developers)
COHERE_API_KEY=

# SambaNova (Free: https://cloud.sambanova.ai/)
SAMBANOVA_API_KEY=

# Cerebras (Trial: https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=

# Pollinations (Free, no key needed)
POLLINATIONS_API_KEY=

# OVHcloud (Free anonymous, no key needed)
OVH_API_KEY=

# LLM7.io (Free token: https://token.llm7.io)
LLM7_API_KEY=

# --- Discovery Settings ---
DISCOVERY_INTERVAL_MS=3600000  # 1 hour
HEALTH_CHECK_INTERVAL_MS=60000  # 1 minute
COOLDOWN_MS=300000  # 5 minutes
DEAD_COOLDOWN_MS=3600000  # 1 hour

# --- Telegram (for bansos discovery) ---
TELEGRAM_BOT_TOKEN=

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=./data/gateway.log