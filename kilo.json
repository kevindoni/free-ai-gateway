{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "free-ai-gateway": {
      "type": "local",
      "command": [
        "node",
        "D:\\PALIKASIKU\\Agentbrowser\\node_modules\\tsx\\dist\\cli.mjs",
        "D:\\PALIKASIKU\\Agentbrowser\\src\\mcp-server.ts"
      ],
      "environment": {
        "DATA_DIR": "D:\\PALIKASIKU\\Agentbrowser\\data"
      },
      "enabled": true,
